{
  "name" : "@vempain/vempain-file-frontend",
  "type" : "module",
  "version" : "0.9.0",
  "description" : "Vempain File frontend",
  "author" : "Paul-Erik Törrönen",
  "homepage" : "https://vempain.poltsi.fi",
  "license" : "GPL-2.0",
  "packageManager" : "yarn@4.16.0",
  "scripts" : {
    "prebuild" : "node generateBuildInfo.js",
    "prestart" : "node generateBuildInfo.js",
    "start" : "env-cmd -f .env.local vite",
    "build" : "yarn prebuild && tsc && env-cmd -f .env.prod vite build",
    "test" : "jest",
    "test:watch" : "jest --watch",
    "test:coverage" : "jest --coverage .",
    "test:debug" : "jest --inspect-brk --runInBand --no-cache",
    "preview" : "vite preview",
    "build:production" : "yarn prebuild && env-cmd -f .env.prod vite build",
    "lint" : "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix" : "eslint . --ext ts,tsx --fix"
  },
  "dependencies" : {
    "@vempain/vempain-auth-frontend" : "^1.0.16",
    "antd" : "^6.5.1",
    "axios" : "^1.18.1",
    "dayjs" : "^1.11.21",
    "i18next" : "^26.3.6",
    "i18next-http-backend" : "^4.0.0",
    "leaflet" : "^1.9.4",
    "react" : "^19.2.7",
    "react-dom" : "^19.2.7",
    "react-i18next" : "^17.0.10",
    "react-leaflet" : "5.0.0",
    "react-router-dom" : "^7.18.1"
  },
  "devDependencies" : {
    "@eslint/js" : "^10.0.1",
    "@testing-library/jest-dom" : "^6.9.1",
    "@types/jest" : "^30.0.0",
    "@types/leaflet" : "^1.9.21",
    "@types/react" : "^19.2.17",
    "@types/react-dom" : "^19.2.3",
    "@vitejs/plugin-react" : "^6.0.3",
    "env-cmd" : "^11.0.0",
    "eslint" : "^10.7.0",
    "eslint-plugin-react-hooks" : "^7.1.1",
    "eslint-plugin-react-refresh" : "^0.5.3",
    "globals" : "^17.7.0",
    "jest" : "^30.4.2",
    "jest-environment-jsdom" : "^30.4.1",
    "translation-check" : "^1.1.1",
    "ts-jest" : "^29.4.11",
    "typescript" : "^6.0.3",
    "typescript-eslint" : "^8.64.0",
    "vite" : "^8.1.5"
  },
  "eslintConfig" : {
    "extends" : [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest" : {
    "preset" : "ts-jest/presets/default-esm",
    "testEnvironment" : "jest-environment-jsdom",
    "setupFiles" : [
      "<rootDir>/jest.setup.ts"
    ],
    "extensionsToTreatAsEsm" : [
      ".ts",
      ".tsx"
    ],
    "transform" : {
      "^.+\\.[tj]sx?$" : [
        "ts-jest",
        {
          "tsconfig" : "tsconfig.test.json",
          "useESM" : true
        }
      ]
    },
    "moduleNameMapper" : {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$" : "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less)$" : "<rootDir>/__mocks__/styleMock.js",
      "^(.*)/resolveApiUrl$" : "<rootDir>/__mocks__/resolveApiUrl"
    }
  },
  "repository" : {
    "type" : "git",
    "url" : "git+https://github.com/Vempain/vempain-file-frontend.git"
  }
}
